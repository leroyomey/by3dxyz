# Names only. Real values stay in local .env (gitignored).
# When going live, copy these into GitHub Actions secrets — see _private/github-keys.md on this PC

# PayPal Client ID from https://developer.paypal.com/dashboard/applications/live
# LIVE Client ID only. Never put the PayPal Secret in this project.
PUBLIC_PAYPAL_CLIENT_ID=

# Inbox that receives each paid order (SKU, color, size, qty, ship-to).
# First Formsubmit message asks you to confirm this address.
PUBLIC_ORDER_NOTIFY_EMAIL=hello@by3dxyz.com

# Etsy Open API from https://www.etsy.com/developers/your-apps
ETSY_API_KEY=
ETSY_API_SHARED_SECRET=
ETSY_SHOP_NAME=by3dxyz
# After `npm run catalog:auth` (do not commit these). Refresh token is required on GitHub for stock sync:
# ETSY_ACCESS_TOKEN=
# ETSY_REFRESH_TOKEN=
# ETSY_TOKEN_EXPIRES=
