---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CyberStage from "../components/CyberStage.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  robots?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const brandShare = "/images/share.jpg";
const {
  title,
  description = site.description,
  image = brandShare,
  imageAlt = `${site.name} 3D printing`,
  robots,
  ogType = "website",
  jsonLd,
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tabTitle}`;
const origin = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, origin).href;
const jsonLdDocument = jsonLd
  ? Array.isArray(jsonLd)
    ? { "@context": "https://schema.org", "@graph": jsonLd }
    : { "@context": "https://schema.org", ...jsonLd }
  : null;
const productShare = /^\/images\/products\/.+\.jpe?g$/i.test(image)
  ? image.replace("/images/products/", "/images/share/").replace(/\.jpeg$/i, ".jpg")
  : "";
const ogImagePath = productShare || image;
const shareImage = new URL(ogImagePath, origin).href;
const isBrandShare = image === brandShare;
const ogImageWidth = productShare ? "1200" : isBrandShare ? "1200" : "";
const ogImageHeight = productShare ? "1200" : isBrandShare ? "630" : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#06040c" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:secure_url" content={shareImage} />
    <meta property="og:image:alt" content={imageAlt} />
    {ogImageWidth && <meta property="og:image:width" content={ogImageWidth} />}
    {ogImageHeight && <meta property="og:image:height" content={ogImageHeight} />}
    <meta property="og:image:type" content="image/jpeg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {jsonLdDocument && <script type="application/ld+json" set:html={JSON.stringify(jsonLdDocument)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oxanium:wght@500;600;700;800&family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <CyberStage />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
