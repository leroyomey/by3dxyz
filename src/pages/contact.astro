---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
---

<Layout title="Contact" description="Contact by3DXYZ about an order or a shop question.">
  <section class="bleed-page bleed-page-short">
    <div class="wrap">
      <p class="kicker kicker-on-dark">Contact</p>
      <h1>Get in touch</h1>
      <p class="lede">
        Questions about an order or a part in the shop? Send a message. To print a file you already have, use
        <a href="/print">Print a file</a>. For a new design, use
        <a href="/custom">custom work</a>.
      </p>
    </div>
  </section>
  <section class="wrap section">
    <form class="form" action={`mailto:${site.email}`} method="get">
      <label for="name">Name</label>
      <input id="name" name="name" required />
      <label for="email">Email</label>
      <input id="email" name="email" type="email" required />
      <label for="message">Message</label>
      <textarea id="message" name="body" rows="6" required></textarea>
      <button class="btn btn-teal" type="submit">Open email</button>
    </form>
    <p class="muted">Or email {site.email} directly.</p>
  </section>
</Layout>
