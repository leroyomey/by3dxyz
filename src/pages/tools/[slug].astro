---
import Layout from "../../layouts/Layout.astro";
import BuyOptions from "../../components/BuyOptions.astro";
import CartSignal from "../../components/CartSignal.astro";
import EtsyReview from "../../components/EtsyReview.astro";
import StockSignal from "../../components/StockSignal.astro";
import ProductCard from "../../components/ProductCard.astro";
import {
  allProducts,
  getProduct,
  nextProduct,
  prevProduct,
  productCopy,
  productPriceBounds,
  productTitle,
  relatedProducts,
} from "../../data/products";
import { listingLine } from "../../data/site";

export function getStaticPaths() {
  return allProducts.map((product) => ({ params: { slug: product.slug } }));
}

const product = getProduct(Astro.params.slug ?? "");
if (!product) {
  return Astro.redirect("/tools");
}
const title = productTitle(product);
const about = productCopy(product.description);
const next = nextProduct(product.slug);
const prev = prevProduct(product.slug);
const related = relatedProducts(product);
const nextTitle = next ? productTitle(next) : "";
const prevTitle = prev ? productTitle(prev) : "";
const origin = Astro.site ?? Astro.url;
const pageUrl = new URL(`/tools/${product.slug}`, origin).href;
const soldOut = Boolean(product.inactive);
const bounds = productPriceBounds(product);
const availability = soldOut ? "https://schema.org/OutOfStock" : "https://schema.org/InStock";
const offerBase = {
  url: pageUrl,
  priceCurrency: bounds.currency,
  availability,
  itemCondition: "https://schema.org/NewCondition",
};
const jsonLd = {
  "@type": "Product",
  name: title,
  description: product.short,
  sku: product.sku,
  mpn: product.sku,
  image: product.images.map((src) => new URL(src, origin).href),
  brand: { "@type": "Brand", name: "by3DXYZ" },
  offers:
    bounds.max > bounds.min
      ? {
          "@type": "AggregateOffer",
          ...offerBase,
          lowPrice: bounds.min.toFixed(2),
          highPrice: bounds.max.toFixed(2),
        }
      : {
          "@type": "Offer",
          ...offerBase,
          price: Number(bounds.min).toFixed(2),
        },
};
---

<Layout
  title={title}
  description={product.short}
  image={product.images[0]}
  imageAlt={title}
  ogType="product"
  jsonLd={jsonLd}
>
  <article class="wrap product-detail">
    <div class="product-stage">
    <div class="gallery">
      <nav class="product-back" aria-label="Catalog">
        <a class="back-link" href="/tools">← Back to shop</a>
        <div class="product-adjacent">
          {
            prev && (
              <a class="back-link" href={`/tools/${prev.slug}`} aria-label={`Previous part: ${prevTitle}`}>
                ← Previous part
              </a>
            )
          }
          {
            next && (
              <a class="back-link" href={`/tools/${next.slug}`} aria-label={`Next part: ${nextTitle}`}>
                Next part →
              </a>
            )
          }
        </div>
      </nav>
      <div class="gallery-main">
        <img src={product.images[0]} alt={title} data-main-image />
      </div>
      {
        product.images.length > 1 && (
          <div class="thumbs">
            {product.images.map((image, index) => (
              <button type="button" data-thumb={image} aria-current={index === 0 ? "true" : "false"}>
                <img src={image} alt={`${title} view ${index + 1}`} />
              </button>
            ))}
          </div>
        )
      }
    </div>
    <div class="product-panel" data-product-panel>
      <span class="buy-stick-sentinel" data-buy-sentinel aria-hidden="true"></span>
      <h1>{title}</h1>
      <BuyOptions product={product}>
        <StockSignal inactive={product.inactive} />
        <CartSignal favorers={product.etsyFavorers} />
        <p class="lede">{product.short}</p>
      </BuyOptions>
    </div>
    </div>
    <section class="product-body">
      <p class="product-body-label">About this part</p>
      <p class="muted">{about}</p>
      <p class="muted listing-line">{listingLine}</p>
      <EtsyReview product={product} />
    </section>
    {
      related.length > 0 && (
        <section class="related-parts" aria-label="Related parts">
          <p class="product-body-label">Related parts</p>
          <div class="product-grid related-grid">
            {related.map((item) => (
              <ProductCard product={item} preview />
            ))}
          </div>
        </section>
      )
    }
  </article>
</Layout>

<script>
  function bindProduct() {
    const panel = document.querySelector("[data-product-panel]");
    if (!(panel instanceof HTMLElement) || panel.dataset.bound === "1") return;
    panel.dataset.bound = "1";

    const sentinel = document.querySelector("[data-buy-sentinel]");
    if (sentinel && "IntersectionObserver" in window) {
      const headerPx = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--header-h")) || 64;
      const observer = new IntersectionObserver(
        ([entry]) => {
          panel.classList.toggle("is-compact", Boolean(entry) && !entry.isIntersecting);
        },
        { rootMargin: `-${headerPx}px 0px 0px 0px`, threshold: 0 },
      );
      observer.observe(sentinel);
    }

    const main = document.querySelector("[data-main-image]");
    document.querySelectorAll("[data-thumb]").forEach((button) => {
      button.addEventListener("click", () => {
        const src = button.getAttribute("data-thumb");
        if (src && main instanceof HTMLImageElement) main.src = src;
        document.querySelectorAll("[data-thumb]").forEach((item) => {
          item.setAttribute("aria-current", item === button ? "true" : "false");
        });
      });
    });
  }

  bindProduct();
  document.addEventListener("astro:page-load", bindProduct);
</script>
