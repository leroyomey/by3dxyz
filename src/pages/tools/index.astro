---
import Layout from "../../layouts/Layout.astro";
import ProductGrid from "../../components/ProductGrid.astro";
import { products, shopFilters, etsyFavorersTotal } from "../../data/products";
import CartSignal from "../../components/CartSignal.astro";
import { site } from "../../data/site";

const favorers = etsyFavorersTotal(products);
---

<Layout
  title="Shop"
  description="Shop 3D printed parts from by3DXYZ. Throwing ribs, paddles, and guitar picks in PLA. Filter the catalog and buy here with PayPal."
>
  <section class="wrap shop-page" data-catalog>
    <header class="shop-head">
      <p class="kicker kicker-on-dark">Catalog</p>
      <h1>Shop</h1>
      <p class="lede">
        Parts we already print. Filter by type, then buy here with PayPal. Also on{" "}
        <a href={site.etsyUrl} target="_blank" rel="noopener noreferrer">Etsy</a>.
      </p>
    </header>
    <div class="shop-toolbar">
      <div class="search-field">
        <label class="search-label muted" for="tool-search">Search</label>
        <input class="search" id="tool-search" type="search" placeholder="Name or SKU" data-search />
      </div>
      <div class="shop-filters" role="group" aria-label="Filter by type">
        {
          shopFilters.map((filter, index) => (
            <button class="chip" type="button" data-filter={filter.id} aria-pressed={index === 0 ? "true" : "false"}>
              {filter.label}
            </button>
          ))
        }
      </div>
      <CartSignal favorers={favorers} scope="shop" />
    </div>
    <div class="shop-results">
      <ProductGrid products={products} />
    </div>
  </section>
</Layout>

<script>
  function bindCatalog() {
    const root = document.querySelector("[data-catalog]");
    if (!(root instanceof HTMLElement) || root.dataset.bound === "1") return;
    root.dataset.bound = "1";
    const chips = [...root.querySelectorAll("[data-filter]")];
    const cards = [...root.querySelectorAll("[data-family]")];
    const empty = root.querySelector("[data-empty]");
    const search = root.querySelector("[data-search]");
    let active = "all";

    function apply() {
      const query = (search instanceof HTMLInputElement ? search.value : "").trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;
        const family = card.dataset.family ?? "";
        const featured = card.dataset.featured === "1";
        const name = card.dataset.name ?? "";
        const matchFilter =
          active === "all" || (active === "featured" && featured) || family === active;
        const matchSearch = !query || name.includes(query);
        const show = matchFilter && matchSearch;
        card.classList.toggle("hidden", !show);
        if (show) visible += 1;
      });
      empty?.classList.toggle("hidden", visible !== 0);
    }

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        active = chip.getAttribute("data-filter") ?? "All";
        chips.forEach((item) => item.setAttribute("aria-pressed", item === chip ? "true" : "false"));
        apply();
      });
    });

    search?.addEventListener("input", apply);
  }

  bindCatalog();
  document.addEventListener("astro:page-load", bindCatalog);
</script>
