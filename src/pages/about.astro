---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
---

<Layout title="About" description="by3DXYZ is a 3D printing service. Print a file, ask for a custom 3D print, or shop parts we already make.">
  <section class="bleed-page bleed-page-short">
    <div class="wrap">
      <p class="kicker kicker-on-dark">About</p>
      <h1>by3DXYZ</h1>
      <p class="lede">
        A 3D printing service. Send a file, ask for a custom print, or buy a part from the shop. Catalog items are
        printed in small batches so the shape stays the same.
      </p>
    </div>
  </section>
  <section class="wrap section prose">
    <p>
      You can buy on this site with PayPal, or on
      <a href={site.etsyUrl} target="_blank" rel="noopener noreferrer">Etsy</a>. Already have a file?
      <a href="/print">Print a file</a>. Need something modeled in AutoCAD first?
      <a href="/custom">Ask for a custom quote</a>.
    </p>
    <p class="hero-actions">
      <a class="btn btn-teal" href="/print">Print a file</a>
      <a class="btn btn-ghost" href="/tools">Shop</a>
      <a class="btn btn-ghost" href="/custom">Custom</a>
    </p>
  </section>
</Layout>
