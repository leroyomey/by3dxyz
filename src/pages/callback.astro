<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Etsy shop login</title>
    <style>
      body {
        font-family: "Segoe UI", sans-serif;
        background: #0b0a10;
        color: #f3efe6;
        max-width: 40rem;
        margin: 4rem auto;
        padding: 0 1.25rem;
        line-height: 1.5;
      }
      code {
        font-size: 0.95em;
      }
    </style>
  </head>
  <body>
    <p>Sending you back to finish the Etsy shop login.</p>
    <p>
      If this tab stays here, run <code>npm run catalog:auth</code> first, then allow access on Etsy again.
    </p>
    <script is:inline>
      (function () {
        var params = new URLSearchParams(window.location.search);
        var code = params.get("code") || "";
        var state = params.get("state") || "";
        if (!code) return;
        var next = new URLSearchParams();
        next.set("code", code);
        if (state) next.set("state", state);
        window.location.replace("http://127.0.0.1:3456/callback?" + next.toString());
      })();
    </script>
  </body>
</html>
