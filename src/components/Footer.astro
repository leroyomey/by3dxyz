---
import { site } from "../data/site";
import VisitCount from "./VisitCount.astro";
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <strong class="logo-type">
        <span class="logo-by">by</span>3D<span class="axis-x">X</span><span class="axis-y">Y</span><span class="axis-z">Z</span>
      </strong>
      <p class="muted">{site.tagline}</p>
      <VisitCount />
    </div>
    <div class="footer-col">
      <p class="footer-head">Catalog</p>
      <a href="/tools">Parts</a>
      <a href={site.etsyUrl} target="_blank" rel="noopener noreferrer">Etsy</a>
    </div>
    <div class="footer-col">
      <p class="footer-head">Print a file</p>
      <a href="/print">Send a file link</a>
      <a href="/print#estimate">Ask for an estimate</a>
    </div>
    <div class="footer-col">
      <p class="footer-head">Custom</p>
      <a href="/custom">Custom printing</a>
      <a href="/custom#quote">Request a quote</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/privacy">Privacy</a>
    </div>
  </div>
  <p class="wrap footer-copy">© 2026 {site.name}</p>
</footer>
