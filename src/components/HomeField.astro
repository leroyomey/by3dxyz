---
import { products } from "../data/products";
import { site } from "../data/site";
import { printFile } from "../data/print-file";
import { pickDailyParts, type DailyPart } from "../data/daily-parts";
import NewBadge from "./NewBadge.astro";

const catalog: DailyPart[] = products.map((product) => ({
  id: product.id,
  sku: product.sku,
  slug: product.slug,
  name: product.name,
  image: product.images[0] || "",
  featured: Boolean(product.featured),
  listedAt: product.listedAt,
}));
const picked = pickDailyParts(catalog);
const dailyKey = picked.map((product) => product.id).join("|");
---

<section class="bleed-hero">
  <div class="wrap hero-copy">
    <p class="kicker kicker-on-dark kicker-live">3D printing service</p>
    <h1>Print your file. Or pick a part we already make.</h1>
    <p class="lede">
      Send an STL, 3MF, or OBJ for an estimate. Need a drawing first? Ask for a custom 3D print. The shop has catalog
      parts we already print. Buy here with PayPal. Also on{" "}
      <a href={site.etsyUrl} target="_blank" rel="noopener noreferrer">Etsy</a>.
    </p>
    <div class="hero-actions">
      <a class="btn btn-teal btn-lg" href="/print">Print a file</a>
      <a class="btn btn-ghost-on-dark btn-lg" href="/custom">Custom</a>
    </div>
  </div>
</section>

<section class="path-overlap">
  <div class="wrap path-grid path-grid-lg path-grid-3">
    <a class="path-card" href="/print">
      <p class="cat">PATH.01 · I have a file</p>
      <h2>Print a file</h2>
      <p class="muted">
        Send an STL, 3MF, or OBJ share link. We slice it, email an estimate, then print after a PayPal invoice. You get
        the printed part.
      </p>
      <span class="path-go">Send a file link</span>
    </a>
    <a class="path-card" href="/custom">
      <p class="cat">PATH.02 · I need a drawing</p>
      <h2>Custom</h2>
      <p class="muted">
        No printable file yet. A sketch, a change to a shop SKU, or an idea. You get a fixed quote, then the printed
        part in the mail.
      </p>
      <span class="path-go">Ask for a quote</span>
    </a>
    <a class="path-card" href="/tools">
      <p class="cat">PATH.03 · Ready to buy</p>
      <h2>Shop</h2>
      <p class="muted">
        Parts we already print, in PLA. Filter the catalog and buy here with PayPal.
      </p>
      <span class="path-go">Browse the shop</span>
    </a>
  </div>
</section>

<section class="spec-strip">
  <div class="wrap spec-strip-inner">
    <div>
      <p class="cat">Material</p>
      <p data-stat>PLA</p>
    </div>
    <div>
      <p class="cat">Envelope</p>
      <p data-stat>~9 in</p>
    </div>
    <div>
      <p class="cat">Estimate</p>
      <p data-stat>{printFile.quoteWindow}</p>
    </div>
    <div>
      <p class="cat">Colors</p>
      <p data-stat>11 shop colors</p>
    </div>
  </div>
</section>

<section class="wrap section catalog-band">
  <div class="section-head">
    <div>
      <p class="kicker">Catalog</p>
      <h2>Parts we print</h2>
      <p class="muted">A few from the catalog. Open the full list for every SKU, with photos of the part.</p>
    </div>
    <a class="btn btn-ghost" href="/tools">Shop</a>
  </div>
  <div class="sku-rail" data-daily-parts data-daily-key={dailyKey}>
    {
      picked.map((product) => (
        <a class="sku-chip" href={`/tools/${product.slug}`}>
          {product.image ? <img src={product.image} alt="" width="40" height="40" /> : null}
          <span class="sku-id">{product.sku}</span>
          <span class="sku-name">{product.name}</span>
          <NewBadge listedAt={product.listedAt} />
        </a>
      ))
    }
  </div>
  <template data-daily-catalog>{JSON.stringify(catalog)}</template>
</section>

<script>
  import { pickDailyParts, type DailyPart } from "../data/daily-parts";
  import { isNewListing } from "../data/listing-age";

  function chipFor(product: DailyPart) {
    const link = document.createElement("a");
    link.className = "sku-chip";
    link.href = `/tools/${product.slug}`;
    if (product.image) {
      const image = document.createElement("img");
      image.src = product.image;
      image.alt = "";
      image.width = 40;
      image.height = 40;
      link.appendChild(image);
    }
    const sku = document.createElement("span");
    sku.className = "sku-id";
    sku.textContent = product.sku;
    const name = document.createElement("span");
    name.className = "sku-name";
    name.textContent = product.name;
    link.append(sku, name);
    if (isNewListing(product.listedAt)) {
      const badge = document.createElement("span");
      badge.className = "badge-new";
      badge.dataset.listedAt = String(product.listedAt || "");
      badge.textContent = "New";
      link.appendChild(badge);
    }
    return link;
  }

  function paintDailyParts() {
    const hold = document.querySelector("[data-daily-catalog]");
    const rail = document.querySelector("[data-daily-parts]");
    if (!(hold instanceof HTMLElement) || !(rail instanceof HTMLElement)) return;
    let catalog: DailyPart[] = [];
    try {
      catalog = JSON.parse(hold.textContent || "[]");
    } catch {
      return;
    }
    if (!Array.isArray(catalog) || !catalog.length) return;
    const picked = pickDailyParts(catalog);
    const next = picked.map((product) => product.id).join("|");
    if (rail.dataset.dailyKey === next) return;
    rail.dataset.dailyKey = next;
    rail.replaceChildren(...picked.map(chipFor));
  }

  paintDailyParts();
  document.addEventListener("astro:page-load", paintDailyParts);
</script>
