---
import type { Product } from "../data/products";
import {
  formatReviewDate,
  reviewsForSku,
  sourceHref,
  sourceLabel,
  starLabel,
  type EtsyReview,
} from "../data/reviews";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const reviews = reviewsForSku(product.sku).filter((review) => review.text?.trim());
const sourceHrefs = { etsy: product.etsyUrl || "" };
const sourceNames = [...new Set(reviews.map((review) => sourceLabel(review.source)).filter(Boolean))];
const heading =
  sourceNames.length === 1
    ? reviews.length === 1
      ? `${sourceNames[0]} review`
      : `${sourceNames[0]} reviews`
    : reviews.length === 1
      ? "Review"
      : "Reviews";

function credit(review: EtsyReview) {
  return [review.buyerName?.trim(), formatReviewDate(review.created)].filter(Boolean).join(" · ");
}

function via(review: EtsyReview) {
  return {
    label: sourceLabel(review.source),
    href: sourceHref(review.source, sourceHrefs),
  };
}

const featured = reviews[0];
const featuredCredit = featured ? credit(featured) : "";
const featuredVia = featured ? via(featured) : { label: "", href: "" };
---

{
  reviews.length > 0 && (
    <section class="product-review" aria-label={heading}>
      <p class="product-body-label">{heading}</p>
      {reviews.length === 1 && featured ? (
        <blockquote>
          <p>{featured.text}</p>
          <footer>
            {featured.rating > 0 && (
              <span class="review-stars" aria-label={starLabel(featured.rating)}>
                {"★".repeat(Math.min(5, Math.max(0, Math.round(featured.rating))))}
              </span>
            )}
            <span>
              {featuredCredit ? `${featuredCredit} · ` : ""}
              {featuredVia.label && (
                <>
                  via{" "}
                  {featuredVia.href ? (
                    <a href={featuredVia.href} target="_blank" rel="noopener noreferrer">
                      {featuredVia.label}
                    </a>
                  ) : (
                    featuredVia.label
                  )}
                </>
              )}
            </span>
          </footer>
        </blockquote>
      ) : (
        <ul class="review-list">
          {reviews.map((review) => {
            const who = credit(review);
            const { label, href } = via(review);
            return (
              <li>
                <blockquote>
                  <p>{review.text}</p>
                  <footer>
                    {review.rating > 0 && (
                      <span class="review-stars" aria-label={starLabel(review.rating)}>
                        {"★".repeat(Math.min(5, Math.max(0, Math.round(review.rating))))}
                      </span>
                    )}
                    <span>
                      {who ? `${who} · ` : ""}
                      {label && (
                        <>
                          via{" "}
                          {href ? (
                            <a href={href} target="_blank" rel="noopener noreferrer">
                              {label}
                            </a>
                          ) : (
                            label
                          )}
                        </>
                      )}
                    </span>
                  </footer>
                </blockquote>
              </li>
            );
          })}
        </ul>
      )}
    </section>
  )
}
