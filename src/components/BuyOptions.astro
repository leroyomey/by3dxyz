---
import type { Product } from "../data/products";
import { productVariants, formatPrice } from "../data/products";
import { site } from "../data/site";
import NewBadge from "./NewBadge.astro";
import PayPalButtons from "./PayPalButtons.astro";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const clientId = import.meta.env.PUBLIC_PAYPAL_CLIENT_ID ?? "";
const variants = productVariants(product);
const needsOptions = variants.length > 0;
const extraGroup = variants.find((group) => group.id !== "color");
const extraWord = extraGroup ? extraGroup.label.trim().toLowerCase() : "";
const optionHint = extraWord ? `Please choose a color and ${extraWord}.` : "Please choose a color.";
const optionOutHint = extraWord
  ? `That color and ${extraWord} is currently sold out.`
  : "That color is currently sold out.";
const soldOut = Boolean(product.inactive);
const quantities = Array.from({ length: 10 }, (_, i) => i + 1);
const etsyUrl = product.etsyUrl || site.etsyUrl;
---

<div
  class="buy-options"
  id="buy"
  data-buy
  data-currency={product.currency}
  data-name={product.name}
  data-sku={product.sku}
  data-href={`/tools/${product.slug}`}
  data-base-price={product.price}
>
  <div class="price-row">
    <p class="price" data-total>{formatPrice(product.price, product.currency)}</p>
    <NewBadge listedAt={product.listedAt} />
    <span class="ship-free">FREE shipping</span>
  </div>
  <div class="buy-proof">
    <slot />
  </div>
  <div class="buy-fields">
    {
      variants.map((group) => (
        <label class="option-field">
          <span>{group.label}</span>
          <select data-option={group.id} data-option-label={group.label} required={needsOptions}>
            <option value="">{group.placeholder}</option>
            {group.values.map((value) => (
              <option value={value.name} data-price={value.price ?? ""}>
                {typeof value.price === "number" ? `${value.name} (${formatPrice(value.price, product.currency)})` : value.name}
              </option>
            ))}
          </select>
        </label>
      ))
    }
    <label class="option-field buy-qty">
      <span>Quantity</span>
      <select data-qty disabled={soldOut}>
        {quantities.map((n) => (
          <option value={n} selected={n === 1}>
            {n}
          </option>
        ))}
      </select>
    </label>
  </div>
  <p class="stock-signal" data-variant-stock></p>
  <p
    class="muted buy-hint"
    data-need-options={needsOptions ? "true" : "false"}
    data-option-hint={optionHint}
    data-option-out={optionOutHint}
  >
      {
        soldOut ? (
          <>This part is not for sale on the site right now.</>
        ) : needsOptions ? (
          optionHint
        ) : (
          ""
        )
      }
  </p>
  {
    !soldOut ? (
      <div class="buy-actions">
        <button type="button" class="btn btn-ghost" data-add-cart disabled={needsOptions}>
          Add to cart
        </button>
        <p class="muted buy-cart-note" data-cart-added hidden>
          Added. <a href="/cart">View cart</a>
        </p>
      </div>
    ) : null
  }
  {
    clientId && !soldOut ? (
      <PayPalButtons clientId={clientId} currency={product.currency} mode="buy" />
    ) : null
  }
  <a class="buy-alt" href={etsyUrl} target="_blank" rel="noopener noreferrer">also on Etsy</a>
  <p class="buy-custom muted">
    <a href={`/custom?sku=${encodeURIComponent(product.sku)}`}>Need this changed?</a>
  </p>
</div>

<script>
  import { addToCart, readBuyState } from "../scripts/shop-cart";

  function paintBuy(root: Element) {
    const state = readBuyState(root);
    const currency = root.getAttribute("data-currency") || "USD";
    const total = root.querySelector("[data-total]");
    const hint = root.querySelector("[data-need-options]");
    const stockEl = root.querySelector("[data-variant-stock]");
    const add = root.querySelector("[data-add-cart]");
    const paypal = root.querySelector("[data-paypal-mount]");
    const needs = hint?.getAttribute("data-need-options") === "true";
    if (total) {
      total.textContent = new Intl.NumberFormat("en-US", { style: "currency", currency }).format(
        state.line.unit * state.line.qty,
      );
    }
    if (stockEl) {
      stockEl.textContent = "";
      stockEl.classList.remove("is-out");
    }
    if (hint && needs) {
      hint.textContent = state.ready ? "" : hint.getAttribute("data-option-hint") || "Please choose a color.";
    }
    if (add instanceof HTMLButtonElement) add.disabled = !state.ready;
    paypal?.classList.toggle("is-disabled", !state.ready);
  }

  function bindBuy() {
    for (const root of document.querySelectorAll("[data-buy]")) {
      if (!(root instanceof HTMLElement)) continue;
      if (root.dataset.buyBound !== "true") {
        root.dataset.buyBound = "true";
        root.addEventListener("change", () => paintBuy(root));
      }
      paintBuy(root);
    }
  }

  if (!window.by3dxyzBuyClick) {
    window.by3dxyzBuyClick = true;
    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const button = target?.closest("[data-add-cart]");
      if (!button) return;
      const root = button.closest("[data-buy]");
      if (!root) return;
      const state = readBuyState(root);
      if (!state.ready) return;
      addToCart(state.line);
      const note = root.querySelector("[data-cart-added]");
      note?.removeAttribute("hidden");
    });
  }

  bindBuy();
  document.addEventListener("astro:page-load", bindBuy);
</script>
