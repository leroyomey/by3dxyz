<div class="cyber-stage space-fx" aria-hidden="true" transition:persist="space-fx">
  <div class="cyber-fog"></div>
  <div class="cyber-grid"></div>
  <div class="cyber-scan"></div>
  <canvas class="cyber-canvas" data-cyber-canvas></canvas>
  <div class="cyber-vignette"></div>
</div>

<script>
  const STORAGE_KEY = "by3dxyz-space-fx";

  /** @type {number} */
  let raf = 0;
  /** @type {HTMLCanvasElement | null} */
  let live = null;
  /** @type {(() => void) | null} */
  let onResize = null;
  /** @type {((now: number) => void) | null} */
  let paint = null;
  let showGizmo = location.pathname === "/";

  function mulberry32(seed) {
    let a = seed >>> 0;
    return function rng() {
      a |= 0;
      a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function readSeed() {
    try {
      const raw = sessionStorage.getItem(STORAGE_KEY);
      if (!raw) return null;
      const data = JSON.parse(raw);
      const seed = Number(data?.seed);
      if (!Number.isFinite(seed)) return null;
      return seed >>> 0;
    } catch (_err) {
      return null;
    }
  }

  function writeSeed(seed, w, h) {
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify({ seed, w, h }));
    } catch (_err) {}
  }

  function getSeed() {
    const stored = readSeed();
    if (stored != null) return stored;
    const seed = (Math.random() * 0x100000000) >>> 0;
    return seed;
  }

  function boot() {
    const canvas = document.querySelector("[data-cyber-canvas]");
    if (!(canvas instanceof HTMLCanvasElement)) return;
    if (canvas === live && canvas.dataset.spaceReady === "1") {
      showGizmo = location.pathname === "/";
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        paint?.(performance.now());
      }
      return;
    }

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    if (raf) cancelAnimationFrame(raf);
    live = canvas;
    canvas.dataset.spaceReady = "1";

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const particles = [];
    const count = window.innerWidth < 720 ? 18 : 52;
    const start = performance.now();
    const seed = getSeed();
    showGizmo = location.pathname === "/";
    canvas.dataset.spaceSeed = String(seed);

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      canvas.width = Math.max(1, Math.floor(w * dpr));
      canvas.height = Math.max(1, Math.floor(h * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      for (const p of particles) {
        if (w > 0) p.x = ((p.x % w) + w) % w;
        if (h > 0) p.y = ((p.y % h) + h) % h;
      }
    }

    function seedParticles() {
      particles.length = 0;
      const w = Math.max(1, canvas.clientWidth);
      const h = Math.max(1, canvas.clientHeight);
      const rng = mulberry32(seed);
      writeSeed(seed, w, h);
      for (let i = 0; i < count; i += 1) {
        particles.push({
          x: rng() * w,
          y: rng() * h,
          z: rng(),
          s: 0.6 + rng() * 1.8,
          vx: (rng() - 0.5) * 0.18,
          vy: -0.08 - rng() * 0.22,
          hue: rng() > 0.55 ? "y" : rng() > 0.4 ? "x" : "z",
        });
      }
    }

    function color(hue, a) {
      if (hue === "x") return `rgba(255,43,214,${a})`;
      if (hue === "y") return `rgba(0,240,255,${a})`;
      return `rgba(255,193,74,${a})`;
    }

    function project(x, y, z, ay) {
      const c = Math.cos(ay);
      const s = Math.sin(ay);
      const rx = x * c - z * s;
      const rz = x * s + z * c;
      const f = 260 / (260 + rz);
      return [rx * f, y * f, f];
    }

    function drawGizmo(cx, cy, t) {
      const ay = t * 0.00045;
      const len = Math.min(canvas.clientWidth, canvas.clientHeight) * 0.16;
      const axes = [
        { v: [len, 0, 0], hue: "x", label: "X" },
        { v: [0, -len, 0], hue: "y", label: "Y" },
        { v: [0, 0, len], hue: "z", label: "Z" },
      ];
      ctx.save();
      ctx.translate(cx, cy);
      ctx.lineCap = "round";
      axes.forEach((axis) => {
        const [x, y, f] = project(axis.v[0], axis.v[1], axis.v[2], ay);
        ctx.strokeStyle = color(axis.hue, 0.35 + 0.45 * f);
        ctx.lineWidth = 2.2;
        ctx.shadowColor = color(axis.hue, 0.8);
        ctx.shadowBlur = 12;
        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.lineTo(x, y);
        ctx.stroke();
        ctx.font = "600 11px 'Share Tech Mono', monospace";
        ctx.fillStyle = color(axis.hue, 0.95);
        ctx.shadowBlur = 8;
        ctx.fillText(axis.label, x + 6, y + 4);
      });
      ctx.shadowBlur = 16;
      ctx.fillStyle = "rgba(232,240,255,0.95)";
      ctx.beginPath();
      ctx.arc(0, 0, 4, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    function frame(now) {
      if (live !== canvas) return;
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      ctx.clearRect(0, 0, w, h);
      particles.forEach((p) => {
        if (!reduced) {
          p.x += p.vx;
          p.y += p.vy;
          if (p.y < -8) p.y = h + 8;
          if (p.x < -8) p.x = w + 8;
          if (p.x > w + 8) p.x = -8;
        }
        ctx.fillStyle = color(p.hue, 0.18 + p.z * 0.55);
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.s, 0, Math.PI * 2);
        ctx.fill();
      });
      if (showGizmo) drawGizmo(w * 0.72, h * 0.42, reduced ? 0 : now - start);
      if (!reduced) raf = requestAnimationFrame(frame);
    }

    paint = frame;
    onResize = () => {
      if (live !== canvas) return;
      resize();
      if (reduced) frame(performance.now());
    };
    resize();
    seedParticles();
    frame(performance.now());
  }

  window.addEventListener("resize", () => onResize?.());
  boot();
  document.addEventListener("astro:page-load", () => {
    showGizmo = location.pathname === "/";
    boot();
  });
</script>
