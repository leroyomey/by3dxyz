<p class="visit-count" data-visit-count hidden transition:persist="visit-count">
  <span data-visit-n></span> visits
</p>

<script is:inline>
  (function () {
    const key = "by3dxyz-shop-visits";
    const base = "https://countapi.mileshilliard.com/api/v1";
    const flag = "by3dxyz-visit-counted";
    const cacheKey = "by3dxyz-visit-n";

    function counted() {
      try {
        return sessionStorage.getItem(flag) === "1";
      } catch (_err) {
        return Boolean(window.by3dxyzVisitDone);
      }
    }

    function markCounted() {
      window.by3dxyzVisitDone = true;
      try {
        sessionStorage.setItem(flag, "1");
      } catch (_err) {}
    }

    function cached() {
      if (Number.isFinite(window.by3dxyzVisitN)) return window.by3dxyzVisitN;
      try {
        const raw = sessionStorage.getItem(cacheKey);
        if (raw != null) return Number(raw);
      } catch (_err) {}
      return null;
    }

    function paint(value) {
      const n = Number(value);
      if (!Number.isFinite(n) || n < 0) return false;
      const text = new Intl.NumberFormat("en-US").format(n);
      window.by3dxyzVisitN = n;
      try {
        sessionStorage.setItem(cacheKey, String(n));
      } catch (_err) {}
      document.querySelectorAll("[data-visit-n]").forEach(function (el) {
        el.textContent = text;
      });
      document.querySelectorAll("[data-visit-count]").forEach(function (el) {
        el.removeAttribute("hidden");
      });
      return true;
    }

    function read(path) {
      return fetch(base + "/" + path + "/" + encodeURIComponent(key)).then(function (res) {
        if (!res.ok) throw new Error(String(res.status));
        return res.json();
      }).then(function (data) {
        return data && data.value;
      });
    }

    function refresh(increment) {
      const shown = cached();
      if (shown != null) paint(shown);
      return read(increment ? "hit" : "get")
        .then(function (value) {
          if (paint(value) && increment) markCounted();
        })
        .catch(function () {
          if (!increment) return;
          return read("get").then(function (value) {
            paint(value);
          }).catch(function () {});
        });
    }

    function onPageLoad() {
      if (window.by3dxyzVisitBusy) {
        const shown = cached();
        if (shown != null) paint(shown);
        return;
      }
      window.by3dxyzVisitBusy = true;
      refresh(!counted()).finally(function () {
        window.by3dxyzVisitBusy = false;
      });
    }

    function paintCached() {
      const shown = cached();
      if (shown != null) paint(shown);
    }

    if (!window.by3dxyzVisitBound) {
      window.by3dxyzVisitBound = true;
      document.addEventListener("astro:page-load", onPageLoad);
      document.addEventListener("astro:after-swap", paintCached);
      window.by3dxyzVisitTimer = window.setInterval(function () {
        if (window.by3dxyzVisitBusy) return;
        window.by3dxyzVisitBusy = true;
        refresh(false).finally(function () {
          window.by3dxyzVisitBusy = false;
        });
      }, 6 * 60 * 1000);
    }
    onPageLoad();
  })();
</script>
