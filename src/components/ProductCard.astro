---
import type { Product } from "../data/products";
import { shippingNote } from "../data/site";
import { cardShort, displayPrice, productFamily, productTitle } from "../data/products";
import BuyButtons from "./BuyButtons.astro";
import CartSignal from "./CartSignal.astro";
import NewBadge from "./NewBadge.astro";
import StockSignal from "./StockSignal.astro";

interface Props {
  product: Product;
  preview?: boolean;
}

const { product, preview = false } = Astro.props;
const pageUrl = `/tools/${product.slug}`;
const title = productTitle(product);
const family = productFamily(product);
const short = cardShort(product);
---

<article
  class:list={["product-card", preview && "is-preview"]}
  data-category={product.category}
  data-family={family}
  data-featured={product.featured ? "1" : ""}
  data-name={`${title} ${short} ${family}`.toLowerCase()}
>
  <a class="thumb" href={pageUrl}>
    <img src={product.images[0]} alt={title} />
  </a>
  <div class="body">
    <h3><a href={pageUrl}>{title}</a></h3>
    <p class="muted listing-line">{short}</p>
    <div class="price-row">
      <div class="price">{displayPrice(product)}</div>
      <NewBadge listedAt={product.listedAt} />
      <span class="ship-note">{shippingNote}</span>
    </div>
    {
      !preview && (
        <>
          <StockSignal inactive={product.inactive} />
          <CartSignal favorers={product.etsyFavorers} />
          <BuyButtons product={product} compact />
        </>
      )
    }
  </div>
</article>
