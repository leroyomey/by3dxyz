---
import DesignRights from "./DesignRights.astro";
import { designRights } from "../data/design-rights";
import { printColors, printFile } from "../data/print-file";
import { site } from "../data/site";
import { trustedFileLinkError } from "../data/trusted-file-links";

const notifyEmail =
  import.meta.env.PUBLIC_ORDER_NOTIFY_EMAIL?.trim() || site.email;
---

<div class="print-board" data-print>
  <div class="request-thanks" data-print-thanks hidden>
    <p class="kicker">Print request</p>
    <h2>Thank you</h2>
    <p>{printFile.thanksCopy}</p>
    <p>
      <a class="btn btn-teal" href="/tools">Back to the shop</a>
    </p>
  </div>

  <form class="form print-form" data-print-form>
    <ol class="print-track">
      <li>
        <strong>{printFile.steps[0].name}</strong>
        <span class="muted">{printFile.steps[0].copy}</span>
        <label for="print-file">File link (Google Drive, Dropbox, WeTransfer, or similar)</label>
        <input
          id="print-file"
          name="file_link"
          type="url"
          inputmode="url"
          placeholder="https://"
          required
          data-trusted-file-link
          aria-describedby="print-file-help"
          aria-errormessage="print-file-error"
        />
        <p class="form-error" id="print-file-error" data-trusted-file-link-error hidden></p>
        <p class="muted form-help" id="print-file-help">{printFile.linkCopy}</p>
        <label for="print-notes">Anything else we should know</label>
        <textarea id="print-notes" name="notes" rows="4" placeholder="Material notes, orientation, or a Thingiverse / Printables link."></textarea>
      </li>

      <li>
        <strong>{printFile.steps[1].name}</strong>
        <span class="muted">{printFile.steps[1].copy}</span>
        <label for="print-name">Name</label>
        <input id="print-name" name="name" autocomplete="name" required />
        <label for="print-email">Email</label>
        <input id="print-email" name="email" type="email" autocomplete="email" required />
        <label for="print-size">Size notes</label>
        <textarea
          id="print-size"
          name="size_notes"
          rows="3"
          required
          placeholder="Units, scale, or bounding box. Example: print at 100%, about 4 in wide."
        ></textarea>
        <div class="print-qty-row">
          <label class="option-field">
            <span>Color</span>
            <select id="print-color" name="color" required>
              <option value="">Select a color</option>
              {printColors.map((name) => (
                <option value={name}>{name}</option>
              ))}
            </select>
          </label>
          <label class="option-field">
            <span>Quantity</span>
            <select id="print-qty" name="qty">
              {Array.from({ length: 8 }, (_, i) => i + 1).map((n) => (
                <option value={n} selected={n === 1}>
                  {n}
                </option>
              ))}
            </select>
          </label>
        </div>
        <p class="muted form-help">{printFile.colorCopy}</p>
      </li>

      <li>
        <strong>{printFile.steps[2].name}</strong>
        <span class="muted">{printFile.invoiceCopy} {printFile.chargeCopy}</span>
        <span class="muted">{printFile.quoteLead}</span>
        <span class="muted">{printFile.maxPieceCopy}</span>
        <span class="muted">{printFile.colorCopy}</span>
        <DesignRights idPrefix="print" />
        <div class="form-trap" aria-hidden="true">
          <label for="print-company">Company website</label>
          <input id="print-company" name="_honey" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <p class="muted" data-print-status></p>
        <button class="btn btn-teal btn-lg" type="submit" data-print-submit>Send for an estimate</button>
      </li>
    </ol>
  </form>
</div>

<script is:inline define:vars={{ notifyEmail, contactEmail: site.email, fileLinkError: trustedFileLinkError, missingWarrant: designRights.missingWarrant, missingSource: designRights.missingSource, licenseRequiredCopy: designRights.licenseRequiredCopy }}>
  (function () {
    const root = document.querySelector("[data-print]");
    const form = document.querySelector("[data-print-form]");
    if (!root || !(form instanceof HTMLFormElement)) return;

    const openedAt = Date.now();

    function showThanks() {
      const thanks = root.querySelector("[data-print-thanks]");
      root.classList.add("is-sent");
      if (thanks) thanks.removeAttribute("hidden");
    }

    form.addEventListener("submit", function (event) {
      event.preventDefault();
      const status = root.querySelector("[data-print-status]");
      const button = root.querySelector("[data-print-submit]");
      const data = new FormData(form);
      const honey = String(data.get("_honey") || "").trim();
      if (honey) return;
      if (Date.now() - openedAt < 4000) {
        if (status) status.textContent = "Take a second, then send again.";
        return;
      }
      try {
        const last = Number(sessionStorage.getItem("print-sent") || 0);
        if (last && Date.now() - last < 30000) {
          if (status) status.textContent = "Request already sent. Wait a moment before another.";
          return;
        }
      } catch (_err) {}
      if (String(data.get("warrant") || "") !== "yes") {
        if (status) status.textContent = missingWarrant;
        return;
      }
      const source = String(data.get("design_source") || "");
      if (!source) {
        if (status) status.textContent = missingSource;
        return;
      }
      const proof = String(data.get("license_or_permission") || "").trim();
      if (source !== "own" && !proof) {
        if (status) status.textContent = licenseRequiredCopy;
        return;
      }
      if (proof && typeof window.by3dxyzIsLicenseProof === "function" && !window.by3dxyzIsLicenseProof(proof)) {
        const license = form.querySelector("[data-license-proof]");
        if (license instanceof HTMLInputElement) {
          license.reportValidity();
          return;
        }
      }
      const fileLink = form.querySelector("[data-trusted-file-link]");
      if (fileLink instanceof HTMLInputElement) {
        const link = fileLink.value.trim();
        const trusted = typeof window.by3dxyzIsTrustedFileLink === "function" && window.by3dxyzIsTrustedFileLink(link);
        if (link && !trusted) {
          fileLink.setCustomValidity(fileLinkError);
          fileLink.reportValidity();
          return;
        }
      }
      const payload = {
        _subject: "by3DXYZ print a file request",
        _template: "table",
        _captcha: "false",
        _honey: honey,
        name: String(data.get("name") || ""),
        email: String(data.get("email") || ""),
        file_link: String(data.get("file_link") || "").trim(),
        size_notes: String(data.get("size_notes") || ""),
        color: String(data.get("color") || ""),
        quantity: String(data.get("qty") || "1"),
        notes: String(data.get("notes") || ""),
        design_rights: "yes",
        design_source: source,
        license_or_permission: proof,
        attestation:
          "Customer attests they have the right to have this part printed (" +
          (source === "own" ? "made the design" : source === "license" ? "purchased license" : "owner permission") +
          ")." +
          (proof ? " License or permission: " + proof : ""),
      };
      if (!notifyEmail) {
        if (status) status.textContent = "Could not send. Email " + contactEmail + " instead.";
        return;
      }
      if (button instanceof HTMLButtonElement) button.disabled = true;
      if (status) status.textContent = "Sending…";
      fetch("https://formsubmit.co/ajax/" + encodeURIComponent(notifyEmail), {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(payload),
      })
        .then(function (res) {
          return res.json().then(function (json) {
            return { ok: res.ok, json: json };
          });
        })
        .then(function (result) {
          if (result.ok) {
            try {
              sessionStorage.setItem("print-sent", String(Date.now()));
            } catch (_err) {}
            showThanks();
            return;
          }
          if (status) status.textContent = "Could not send. Email " + contactEmail + " instead.";
        })
        .catch(function () {
          if (status) status.textContent = "Could not send. Email " + contactEmail + " instead.";
        })
        .finally(function () {
          if (button instanceof HTMLButtonElement && !root.classList.contains("is-sent")) {
            button.disabled = false;
          }
        });
    });
  })();
</script>

<script>
  import "../scripts/bind-trusted-file-link";
</script>
